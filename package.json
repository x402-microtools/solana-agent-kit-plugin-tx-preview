{
  "name": "solana-agent-kit-plugin-tx-preview",
  "version": "0.1.0",
  "description": "Opt-in Solana Agent Kit v2 plugin: preview a Solana transaction before signing via a third-party x402-paid API ($0.01 USDC per call). Never signs, sends or blocks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/x402-microtools/solana-agent-kit-plugin-tx-preview.git"
  },
  "keywords": [
    "solana",
    "solana-agent-kit",
    "x402",
    "transaction-simulation",
    "pre-sign"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "solana-agent-kit": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@solana/kit": "^5.5.1",
    "@types/node": "^22.20.5",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "solana-agent-kit": "^2.0.10",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
